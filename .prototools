proto = "0.64.1"
moon = "2.6.6"
node = "26.13.1"
pnpm = "12.23.0"
rust = "1.100.0"

[settings]
detect-strategy = "prefer-prototools"
auto-install = true
telemetry = false

# rust_tool 0.14.1 installs the whole toolchain when rust-toolchain.toml names it (moonrepo/plugins#232). proto 0.64.1
# loads 0.14.0. Remove this once proto's built-in Rust plugin is 0.14.1 or later.
[plugins.tools]
rust = "registry://ghcr.io/moonrepo/rust_tool:0.14.1"
