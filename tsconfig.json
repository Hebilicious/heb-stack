{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vite/client"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/*.ts",
    "packages/*/scripts/**/*.ts",
    "features/**/*.ts",
    "e2e/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["node_modules"]
}
